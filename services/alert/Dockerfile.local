# Local-buildable Alert Bridge image.
# This intentionally replaces the NVIDIA distroless runtime used by Dockerfile
# with a public Python image; it is for functional compatibility testing.
FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc librdkafka-dev libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt
COPY . /app

RUN useradd --create-home --uid 1000 alert && chown -R alert:alert /app
USER alert

EXPOSE 9080
CMD ["python", "enhance_alert_with_vlm.py", "--config", "/app/config.yaml"]
